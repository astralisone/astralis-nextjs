{
  "INVOICE": {
    "name": "Invoice",
    "description": "Commercial invoice for goods or services provided",
    "fields": [
      {
        "name": "vendor_name",
        "type": "string",
        "required": true,
        "aliases": ["supplier", "from", "billed_from", "seller", "provider"],
        "description": "Name of the vendor/supplier issuing the invoice"
      },
      {
        "name": "vendor_address",
        "type": "string",
        "required": false,
        "aliases": ["supplier_address", "from_address", "seller_address"],
        "description": "Full address of the vendor"
      },
      {
        "name": "vendor_tax_id",
        "type": "string",
        "required": false,
        "aliases": ["tax_id", "ein", "vat_number", "gst_number"],
        "description": "Vendor's tax identification number"
      },
      {
        "name": "invoice_number",
        "type": "string",
        "required": true,
        "aliases": ["inv_no", "invoice_#", "document_number", "invoice_id"],
        "description": "Unique invoice number"
      },
      {
        "name": "invoice_date",
        "type": "date",
        "required": true,
        "aliases": ["date", "issued_date", "billing_date"],
        "description": "Date the invoice was issued"
      },
      {
        "name": "due_date",
        "type": "date",
        "required": false,
        "aliases": ["payment_due", "due_by", "payment_due_date"],
        "description": "Payment due date"
      },
      {
        "name": "amount",
        "type": "currency",
        "required": true,
        "aliases": ["total", "grand_total", "amount_due", "total_amount"],
        "description": "Total invoice amount including tax"
      },
      {
        "name": "subtotal",
        "type": "currency",
        "required": false,
        "aliases": ["sub_total", "amount_before_tax"],
        "description": "Amount before tax"
      },
      {
        "name": "tax_amount",
        "type": "currency",
        "required": false,
        "aliases": ["tax", "vat", "gst", "sales_tax"],
        "description": "Total tax amount"
      },
      {
        "name": "currency",
        "type": "string",
        "required": false,
        "aliases": ["currency_code"],
        "description": "Currency code (USD, EUR, etc.)"
      },
      {
        "name": "customer_name",
        "type": "string",
        "required": false,
        "aliases": ["bill_to", "client", "buyer"],
        "description": "Name of the customer being billed"
      },
      {
        "name": "customer_address",
        "type": "string",
        "required": false,
        "aliases": ["bill_to_address", "billing_address"],
        "description": "Customer's billing address"
      },
      {
        "name": "line_items",
        "type": "array",
        "required": false,
        "description": "Individual line items on the invoice",
        "itemSchema": {
          "description": "string",
          "quantity": "number",
          "unit_price": "currency",
          "total": "currency",
          "item_code": "string"
        }
      },
      {
        "name": "payment_terms",
        "type": "string",
        "required": false,
        "aliases": ["terms", "payment_conditions"],
        "description": "Payment terms (Net 30, Net 60, etc.)"
      },
      {
        "name": "po_number",
        "type": "string",
        "required": false,
        "aliases": ["purchase_order", "po", "reference_number"],
        "description": "Associated purchase order number"
      }
    ]
  },
