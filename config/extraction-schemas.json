      },
      {
        "name": "contract_value",
        "type": "currency",
        "required": false,
        "aliases": ["total_value", "contract_amount", "total_contract_price"],
        "description": "Total monetary value of the contract"
      },
      {
        "name": "payment_terms",
        "type": "string",
        "required": false,
        "aliases": ["payment_schedule", "billing_terms"],
