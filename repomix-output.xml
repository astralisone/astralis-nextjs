  /**
   * Clean up resources
   */
  destroy(): void {
    // Clear all scheduled notifications
    for (const [id, timeout] of this.scheduledNotifications) {
      clearTimeout(timeout);
      this.scheduledNotifications.delete(id);
    }
    this.logger.info('NotificationDispatcher destroyed');
  }

