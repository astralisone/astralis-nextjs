        html: payload.metadata?.html ? (payload.metadata.html as string) : body,
        text: body,
        from: `"${emailConfig.fromName || 'Astralis One'}" <${emailConfig.fromAddress}>`,
        userId: payload.senderId, // If senderId is provided, try their Gmail
