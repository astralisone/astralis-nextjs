      //       action: 'LOGIN',
      //       entity: 'USER',
      //       entityId: user.id,
      //     }
      //   });
      // }
    },
  },
};

/**
 * Helper function to get the current session in Server Components
 * Usage: const session = await auth();
 */
export const auth = () => getServerSession(authOptions);
