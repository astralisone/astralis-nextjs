            acc[status].push(task);
            return acc;
          }, {} as Record<string, typeof tasks>);

          return {
            success: true,
            data: {
              columns: kanban,
              counts: {
                NEW: kanban['NEW']?.length || 0,
                IN_PROGRESS: kanban['IN_PROGRESS']?.length || 0,
                NEEDS_REVIEW: kanban['NEEDS_REVIEW']?.length || 0,
                BLOCKED: kanban['BLOCKED']?.length || 0,
              },
            },
