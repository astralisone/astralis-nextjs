      case '1y':
        startDate = new Date(now);
        startDate.setFullYear(now.getFullYear() - 1);
        groupBy = 'month';
        break;
      default:
        startDate = new Date(now);
        startDate.setDate(now.getDate() - 30);
        groupBy = 'day';
    }

    // Build the query based on grouping
    let dateFormat: string;
