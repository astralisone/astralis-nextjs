  } catch (error) {
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        { error: 'Invalid status', details: error.errors },
        { status: 400 }
      );
    }

    console.error('Failed to update action status:', error);
    return NextResponse.json(
      { error: 'Failed to update action status' },
      { status: 500 }
    );
  }
}
