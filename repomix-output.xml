.particle:nth-child(8) { left: 80%; top: 75%; animation-delay: 1.5s; }
.particle:nth-child(9) { left: 90%; top: 50%; animation-delay: 3.5s; }
.particle:nth-child(10) { left: 15%; top: 65%; animation-delay: 4.5s; }

@keyframes particle-float {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 0;
  }
  10% {
    opacity: 0.6;
  }
  90% {
    opacity: 0.6;
  }
  100% {
    transform: translate(var(--particle-x, 100px), var(--particle-y, -100px)) scale(0);
    opacity: 0;
  }
}

/* Particle Stream Effect (Image 4) */
.particle-stream {
  position: absolute;
  width: 100%;
  height: 2px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(0, 212, 255, 0.8) 20%,
    rgba(255, 255, 255, 1) 50%,
    rgba(0, 212, 255, 0.8) 80%,
    transparent
  );
  filter: blur(1px);
  animation: particle-stream 15s linear infinite;
}

@keyframes particle-stream {
  0% {
    transform: translateX(-100%) scaleX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
  }
  90% {
    opacity: 1;
    transform: translateX(50%) scaleX(1);
  }
  100% {
    transform: translateX(100%) scaleX(0);
    opacity: 0;
  }
}

/* ========================================
   TECH GRID & MESH PATTERNS
   ======================================== */

/* Animated Tech Grid (Image 1, 3) */
.tech-grid-animated {
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.15) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 212, 255, 0.15) 1px, transparent 1px);
  background-size: 50px 50px;
  background-position: 0 0, 0 0;
  animation: grid-shift 20s linear infinite;
}

@keyframes grid-shift {
  0% {
    background-position: 0 0, 0 0;
  }
  100% {
    background-position: 50px 50px, 50px 50px;
  }
}

/* Hexagonal Grid Pattern */
.hex-pattern {
  background-image: url("data:image/svg+xml,%3Csvg width='50' height='43.4' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M25 0l12.5 7.2v14.6L25 29 12.5 21.8V7.2L25 0z' fill='none' stroke='rgba(0,212,255,0.1)' stroke-width='1'/%3E%3C/svg%3E");
  background-size: 50px 43.4px;
}

/* Circuit Pattern */
.circuit-pattern {
  background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 10h20M30 10v20M30 30h20M50 30v20M50 50h20M70 50v20M70 70h20' stroke='rgba(0,212,255,0.2)' stroke-width='2' fill='none'/%3E%3Ccircle cx='10' cy='10' r='3' fill='rgba(0,212,255,0.4)'/%3E%3Ccircle cx='30' cy='30' r='3' fill='rgba(0,212,255,0.4)'/%3E%3Ccircle cx='50' cy='50' r='3' fill='rgba(0,212,255,0.4)'/%3E%3Ccircle cx='70' cy='70' r='3' fill='rgba(0,212,255,0.4)'/%3E%3C/svg%3E");
  background-size: 100px 100px;
}

/* ========================================
   ORBITING ELEMENTS (Image 1)
   ======================================== */

/* Tech Icon Orbit Container */
.orbit-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orbit-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(0, 212, 255, 0.2);
}

.orbit-ring-1 {
  width: 200px;
  height: 200px;
}

.orbit-ring-2 {
  width: 300px;
  height: 300px;
}

.orbit-ring-3 {
  width: 400px;
  height: 400px;
}

.orbit-item {
  position: absolute;
  animation: orbit 30s linear infinite;
}

.orbit-item:nth-child(1) { animation-delay: 0s; }
.orbit-item:nth-child(2) { animation-delay: -5s; }
.orbit-item:nth-child(3) { animation-delay: -10s; }
.orbit-item:nth-child(4) { animation-delay: -15s; }
.orbit-item:nth-child(5) { animation-delay: -20s; }
.orbit-item:nth-child(6) { animation-delay: -25s; }

/* Counter-rotate the content so icons stay upright */
.orbit-item-content {
  animation: counter-rotate 30s linear infinite;
}

@keyframes counter-rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-360deg); }
}

/* ========================================
   CONNECTION LINES (Image 3, 4)
   ======================================== */

/* SVG Line Animation */
.connection-line {
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  animation: draw-line 2s ease-out forwards;
}

.connection-line-pulse {
  stroke-dasharray: 10 5;
  animation: pulse-line 2s linear infinite;
}

@keyframes pulse-line {
  0% {
    stroke-dashoffset: 0;
  }
  100% {
    stroke-dashoffset: -15;
  }
}

/* Gradient Line */
.gradient-line {
  background: linear-gradient(
    to right,
    transparent,
    rgba(0, 212, 255, 0.8),
    transparent
  );
  height: 2px;
  animation: shimmer 3s linear infinite;
}

/* ========================================
   GLOW EFFECTS & HALOS
   ======================================== */

/* Radial Glow (Image 1 - around AI icon) */
.radial-glow {
  position: relative;
}

.radial-glow::before {
  content: '';
  position: absolute;
  inset: -50%;
  background: radial-gradient(
    circle,
    rgba(0, 212, 255, 0.4) 0%,
    rgba(0, 212, 255, 0.2) 25%,
    transparent 60%
  );
  animation: glow-pulse 3s ease-in-out infinite;
  pointer-events: none;
}

/* Halo Effect */
.halo {
  position: relative;
}

.halo::before,
.halo::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  border: 2px solid rgba(0, 212, 255, 0.3);
}

.halo::before {
  inset: -20px;
  animation: ring-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.halo::after {
  inset: -40px;
  animation: ring-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  animation-delay: 0.5s;
}

/* ========================================
   BACKGROUND OVERLAYS
   ======================================== */

/* Radial Gradient Overlay (Image 1) */
.overlay-radial-dark {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    rgba(10, 27, 43, 0.95) 0%,
    rgba(5, 16, 24, 0.98) 50%,
    rgba(0, 0, 0, 1) 100%
  );
  pointer-events: none;
}

/* Gradient Overlay (Image 4) */
.overlay-gradient-light {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(10, 27, 43, 0.95) 0%,
    rgba(26, 58, 82, 0.7) 25%,
    rgba(139, 149, 161, 0.4) 75%,
    rgba(229, 231, 235, 0.1) 100%
  );
  pointer-events: none;
}

/* Vignette Effect */
.vignette {
  position: relative;
}

.vignette::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    transparent 0%,
    rgba(0, 0, 0, 0.3) 100%
  );
  pointer-events: none;
}

/* ========================================
   STAR FIELD EFFECT
   ======================================== */

.starfield {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 20% 30%, white, transparent),
    radial-gradient(1px 1px at 60% 70%, white, transparent),
    radial-gradient(2px 2px at 50% 50%, white, transparent),
    radial-gradient(1px 1px at 80% 10%, white, transparent),
    radial-gradient(1px 1px at 90% 60%, white, transparent),
    radial-gradient(2px 2px at 33% 80%, white, transparent),
    radial-gradient(1px 1px at 15% 60%, white, transparent),
    radial-gradient(1px 1px at 75% 40%, white, transparent);
  background-size: 200% 200%, 300% 300%, 250% 250%, 180% 180%, 220% 220%, 280% 280%, 240% 240%, 190% 190%;
  background-position: 0% 0%, 20% 40%, 50% 50%, 70% 30%, 80% 60%, 30% 80%, 10% 20%, 90% 70%;
  opacity: 0.3;
  animation: starfield-twinkle 10s ease-in-out infinite;
}

@keyframes starfield-twinkle {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}

/* ========================================
   SCAN LINE EFFECT
   ======================================== */

.scan-line-effect {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.scan-line-effect::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 2px;
  background: linear-gradient(
    to right,
    transparent,
    rgba(0, 212, 255, 0.8),
    transparent
  );
  box-shadow: 0 0 10px rgba(0, 212, 255, 0.6);
  animation: scan-line 8s linear infinite;
}

/* ========================================
   DEPTH OF FIELD BLUR
   ======================================== */

/* Foreground Blur */
.blur-foreground {
  position: relative;
}

.blur-foreground::before {
  content: '';
  position: absolute;
  inset: -10%;
  background: radial-gradient(
    ellipse at center,
    transparent 40%,
    rgba(10, 27, 43, 0.3) 100%
  );
  backdrop-filter: blur(3px);
  pointer-events: none;
}

/* Background Blur */
.blur-background {
  position: relative;
  overflow: hidden;
}

.blur-background::after {
  content: '';
  position: absolute;
  inset: 0;
  backdrop-filter: blur(20px);
  mask-image: radial-gradient(
    ellipse at center,
    transparent 30%,
    black 70%
  );
  pointer-events: none;
}

/* ========================================
   ANIMATED GRADIENTS
   ======================================== */

.gradient-shift {
  background: linear-gradient(
    45deg,
    #0A1B2B,
    #1a3a52,
    #0A1B2B,
    #1a3a52
  );
  background-size: 400% 400%;
  animation: gradient-shift 15s ease infinite;
}

@keyframes gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* Cyan Gradient Animation */
.gradient-cyan-shift {
  background: linear-gradient(
    135deg,
    rgba(0, 212, 255, 0.2),
    rgba(0, 168, 204, 0.3),
    rgba(0, 212, 255, 0.2)
  );
  background-size: 200% 200%;
  animation: gradient-shift 10s ease infinite;
}

/* ========================================
   HOLOGRAPHIC EFFECT
   ======================================== */

.holographic {
  position: relative;
  background: linear-gradient(
    135deg,
    rgba(0, 212, 255, 0.1) 0%,
    rgba(0, 168, 204, 0.2) 25%,
    rgba(43, 108, 176, 0.1) 50%,
    rgba(0, 168, 204, 0.2) 75%,
    rgba(0, 212, 255, 0.1) 100%
  );
  background-size: 200% 200%;
  animation: holographic-shift 3s ease infinite;
}

.holographic::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    transparent,
    rgba(255, 255, 255, 0.1),
    transparent
  );
  animation: shimmer 2s linear infinite;
}

@keyframes holographic-shift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* ========================================
   LOADING ANIMATIONS
   ======================================== */

/* Pulsing Dot Loader */
.dot-loader {
  display: flex;
  gap: 8px;
}

.dot-loader span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #00D4FF;
  animation: dot-pulse 1.4s infinite ease-in-out both;
}

.dot-loader span:nth-child(1) { animation-delay: -0.32s; }
.dot-loader span:nth-child(2) { animation-delay: -0.16s; }

@keyframes dot-pulse {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Spinning Ring Loader */
.ring-loader {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(0, 212, 255, 0.2);
  border-top-color: #00D4FF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
</file>

